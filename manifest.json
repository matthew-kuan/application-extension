{
  "manifest_version": 3,
  "name": "Job Application Autofill",
  "version": "0.1.0",
  "description": "One click fills Workday and other job applications from your resume. Stops before Submit.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkday.com/*",
    "https://*.myworkdaysite.com/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Autofill this application (click again to stop)" },
  "options_page": "options.html",
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "Autofill this application" }
  }
}
